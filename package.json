{
  "name": "project-doctor",
  "displayName": "Project Doctor",
  "description": "A VS Code extension that analyzes entire software projects for issues, dependencies, and code relationships",
  "version": "0.1.0",
  "publisher": "project-doctor",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "project-doctor.scanProject",
        "title": "Project Doctor: Scan Project",
        "icon": "$(search)"
      },
      {
        "command": "project-doctor.openDashboard",
        "title": "Project Doctor: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "project-doctor.refreshView",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-doctor",
          "title": "Project Doctor",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "project-doctor": [
        {
          "id": "project-doctor-overview",
          "name": "Overview",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "project-doctor.scanProject",
          "when": "view == project-doctor-overview",
          "group": "navigation"
        },
        {
          "command": "project-doctor.refreshView",
          "when": "view == project-doctor-overview",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "graphology": "^0.25.4",
    "graphology-types": "^0.24.7",
    "php-parser": "^3.7.0",
    "simple-git": "^3.21.0",
    "sql.js": "^1.8.0"
  }
}
